theme_override_font_sizes/font_size = 32
text = "Stack digunakan untuk membantu pengelolaan data yang membutuhkan urutan tertentu. Tujuan utama penggunaan stack adalah agar proses penyimpanan dan pengambilan data menjadi lebih teratur dan mudah dikendalikan."
