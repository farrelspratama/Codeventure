autowrap_mode = 2

[node name="Label3" type="Label" parent="VBoxContainer"]
custom_minimum_size = Vector2(780, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Beberapa tujuan penggunaan stack antara lain:"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Label4" type="Label" parent="VBoxContainer"]
custom_minimum_size = Vector2(780, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "- Mengatur data berdasarkan urutan masuk dan keluar.
- Mempermudah proses penyimpanan data sementara.
- Membantu proses pemanggilan fungsi dalam program.
- Digunakan untuk fitur undo dan redo pada aplikasi.
- Membantu proses pengecekan tanda kurung atau sintaks.
- Digunakan dalam navigasi halaman web seperti tombol back pada browser."
autowrap_mode = 2

