[node name="DialogText2" type="Node" parent="Entities/Kak Seno/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Ehh halo! Ternyata benar kamu sedang berlibur."
can_fast_forward = null
read_time_delay = null
npc_info = ExtResource("19_oxmdp")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="Entities/Kak Seno/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Haha, iya Kak. Mumpung sedang libur panjang."
can_fast_forward = null
read_time_delay = null
npc_info = ExtResource("19_oxmdp")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText4" type="Node" parent="Entities/Kak Seno/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Oh ya kamu ingat Pak Sofyan?"
can_fast_forward = null
read_time_delay = null
npc_info = ExtResource("19_oxmdp")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText5" type="Node" parent="Entities/Kak Seno/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Ingat Kak, guru komputer di sekolah kan."
can_fast_forward = null
read_time_delay = null
npc_info = ExtResource("19_oxmdp")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText6" type="Node" parent="Entities/Kak Seno/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Iya, dia butuh bantuan."
can_fast_forward = null
read_time_delay = null
npc_info = ExtResource("19_oxmdp")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText7" type="Node" parent="Entities/Kak Seno/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Katanya komputer di sekolah rusak."
can_fast_forward = null
read_time_delay = null
npc_info = ExtResource("19_oxmdp")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText8" type="Node" parent="Entities/Kak Seno/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Saya yakin kamu bisa bantu, dia sekarang ada di sekolah."
