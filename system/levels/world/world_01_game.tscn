[node name="DialogText2" type="Node" parent="Entities/Zidan/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Iya, baru sampai tadi."
npc_info = ExtResource("15_umk0s")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="Entities/Zidan/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Kalau mau jalan-jalan, sekarang desa lagi lumayan ramai."
npc_info = ExtResource("24_7g0gs")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText4" type="Node" parent="Entities/Zidan/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Barusan aku ketemu Kak Seno."
