[node name="DialogText7" type="Node" parent="Entities/Zidan/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Iya, guru yang dulu sering ngajarin matematika."
npc_info = ExtResource("24_7g0gs")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText8" type="Node" parent="Entities/Zidan/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Coba kamu temui dia sepertinya sedang berjalan jalan di belakang."
