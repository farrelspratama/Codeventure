[node name="DialogText2" type="Node" parent="Entities/Pak Tatang/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Haha, iya Pak. Masih ingat ternyata."
npc_info = ExtResource("15_umk0s")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="Entities/Pak Tatang/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Dulu sering jajan cilok pas sekolah di sini."
npc_info = ExtResource("25_7g0gs")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText4" type="Node" parent="Entities/Pak Tatang/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Masih sama aja Pak gerobaknya."
npc_info = ExtResource("15_umk0s")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText5" type="Node" parent="Entities/Pak Tatang/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Oh iya, tadi Zidan kesini dan nanyain kamu."
npc_info = ExtResource("25_7g0gs")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText6" type="Node" parent="Entities/Pak Tatang/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Memangnya ada apa Pak?"
npc_info = ExtResource("15_umk0s")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText7" type="Node" parent="Entities/Pak Tatang/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("14_xijt8")
text = "Wah kurang tau saya."
