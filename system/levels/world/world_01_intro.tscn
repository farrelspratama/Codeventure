[node name="DialogText25" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Alhamdulillah akhirnya cucu Kakek datang juga."
npc_info = ExtResource("7_bbiq2")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText26" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Perjalanan jauh capek, ya?"
npc_info = ExtResource("7_bbiq2")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText27" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Lumayan... tapi senang akhirnya sampai."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText28" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Sudah istirahat dulu, ayo masuk."
npc_info = ExtResource("7_bbiq2")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

