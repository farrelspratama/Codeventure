[node name="DialogText" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Wah... akhirnya sampai juga."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText2" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Perjalanannya lumayan panjang juga."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Tapi rasanya langsung beda begitu sampai sini."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText4" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Udaranya sejuk banget..."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText5" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Dan suasananya masih sama seperti dulu."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogCutscene2" type="Node" parent="DialogInteraction"]
script = ExtResource("6_o1q0s")
metadata/_custom_type_script = "uid://cdx54srqhmplq"

[node name="CutsceneActionPlayerMove" type="Node2D" parent="DialogInteraction/DialogCutscene2"]
position = Vector2(500, -125)
script = ExtResource("12_cvbe6")
timing_method = 1
move_speed = 70.0
metadata/_custom_type_script = "uid://bnb2lbg2ro1g0"

[node name="DialogText6" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Banyak yang berubah... tapi beberapa tempat masih kelihatan familiar."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText7" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Itu warung Pak Rudi masih ada ternyata."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText8" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Dan lapangan itu... dulu tempat aku main tiap sore."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogCutscene3" type="Node" parent="DialogInteraction"]
script = ExtResource("6_o1q0s")
metadata/_custom_type_script = "uid://cdx54srqhmplq"

[node name="CutsceneActionMove2" type="Node2D" parent="DialogInteraction/DialogCutscene3" node_paths=PackedStringArray("object_to_move")]
position = Vector2(499, -143)
script = ExtResource("8_s4m0r")
timing_method = 1
object_to_move = NodePath("../../../Temen")
move_speed = 50.0
metadata/_custom_type_script = "uid://baqjcmwvhkv1j"

[node name="DialogText9" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Eh?! Itu kamu, kan?"
npc_info = ExtResource("6_cvbe6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText10" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Hah? Oh!"
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText11" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Seriusan kamu balik ke desa?"
npc_info = ExtResource("6_cvbe6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText12" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "iya, baru sampai tadi."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText13" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Udah lama banget nggak ketemu!"
npc_info = ExtResource("6_cvbe6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText14" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Kamu juga masih sama aja."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText15" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Haha. Jadi sekarang liburan di sini?"
npc_info = ExtResource("6_cvbe6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText16" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "iya. Aku mau nginep beberapa hari di rumah Kakek dan Nenek."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText17" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Ayah dan Ibu nggak bisa ikut karena masih sibuk kerja."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText18" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Oh begitu."
npc_info = ExtResource("6_cvbe6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText19" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Tapi sekalian juga pengen istirahat dari suasana kota."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText20" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Sepertinya Kakek dan Nenekmu udah nunggu dari tadi."
npc_info = ExtResource("6_cvbe6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText21" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Tadi aku lihat mereka bersih-bersih halaman."
npc_info = ExtResource("6_cvbe6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText22" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Wah, jadi nggak enak kalau bikin mereka nunggu lama."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText23" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Nanti kalau ada waktu kita main lagi seperti dulu."
npc_info = ExtResource("6_cvbe6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText24" type="Node" parent="DialogInteraction"]
script = ExtResource("12_0ndb5")
text = "Pasti."
npc_info = ExtResource("11_0ndb5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogCutscene4" type="Node" parent="DialogInteraction"]
