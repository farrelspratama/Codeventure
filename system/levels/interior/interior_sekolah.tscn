[node name="DialogText2" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Pak Sofyan?"
npc_info = ExtResource("13_mfto6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Wah, kamu sudah besar ternyata."
npc_info = ExtResource("7_psujb")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText4" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Kebetulan sekali kamu datang."
npc_info = ExtResource("7_psujb")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText5" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Memangnya kenapa, Pak?"
npc_info = ExtResource("13_mfto6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText6" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Komputer sekolah saya rusak lagi."
npc_info = ExtResource("7_psujb")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText7" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Padahal ada banyak data penting di dalamnya."
npc_info = ExtResource("7_psujb")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText8" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Sudah dicoba diperbaiki?"
npc_info = ExtResource("13_mfto6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText9" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Sudah... tapi makin aneh."
npc_info = ExtResource("7_psujb")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText10" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Kadang layar berkedip sendiri."
npc_info = ExtResource("7_psujb")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText11" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Kadang muncul simbol-simbol aneh."
npc_info = ExtResource("7_psujb")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText12" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Boleh saya lihat?"
npc_info = ExtResource("13_mfto6")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText13" type="Node" parent="Entities/Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("12_h5h4s")
text = "Tentu."
npc_info = ExtResource("7_psujb")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

