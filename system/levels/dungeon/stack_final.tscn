[node name="DialogText" type="Node" parent="Npc/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Agar kesalahan seperti itu tidak terjadi, sistem biasanya memeriksa kondisi stack terlebih dahulu menggunakan operasi [c]isEmpty()[/] dan [c]isFull()[/]."
can_fast_forward = false
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText2" type="Node" parent="Npc/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Sekarang coba selesaikan permasalahan pada penyimpanan di rak sebelah"
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="AreaTrigger" parent="." instance=ExtResource("12_ywbvw")]

[node name="DialogInteraction" parent="AreaTrigger" instance=ExtResource("9_72mcf")]
position = Vector2(549, 311)

[node name="DialogCutscene" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("13_1dtkr")
metadata/_custom_type_script = "uid://cdx54srqhmplq"

[node name="CutsceneActionPlayerMove" type="Node2D" parent="AreaTrigger/DialogInteraction/DialogCutscene"]
z_index = 1
position = Vector2(550, 325)
script = ExtResource("14_n6l3g")
timing_method = 1
move_speed = 80.0
metadata/_custom_type_script = "uid://bnb2lbg2ro1g0"

[node name="DialogText" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Masalah pada partisi sebelumnya sudah berhasil diperbaiki."
can_fast_forward = false
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText2" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Namun masih ada gangguan lain yang menyebabkan sistem tidak stabil."
can_fast_forward = false
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Gangguan seperti apa?"
can_fast_forward = false
npc_info = ExtResource("20_rxorh")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText4" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Beberapa stack di area ini memiliki kapasitas terbatas."
can_fast_forward = false
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText5" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Jika sistem tidak memperhatikan kapasitas tersebut, proses penyimpanan dapat gagal."
can_fast_forward = false
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText6" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Sebelum sistem menambah atau mengambil data, sistem harus mengenali kondisi penyimpanannya terlebih dahulu."
can_fast_forward = false
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText7" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Sekarang coba kamu identifikasi kondisi beberapa rak berikut."
can_fast_forward = false
image = ExtResource("16_u16bm")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText8" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Sekarang perhatikan dua keadaan berikut."
can_fast_forward = false
image = ExtResource("17_bjq26")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText9" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Rak sudah penuh, kemudian sebuah data baru akan dimasukkan."
can_fast_forward = false
image = ExtResource("18_42pdu")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText10" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Menurutmu, apa yang akan terjadi jika sistem tetap memaksa menambahkan buku ke rak tersebut?"
can_fast_forward = false
image = ExtResource("18_42pdu")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText11" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Karena tidak ada lagi ruang yang tersedia, buku tersebut tidak dapat disimpan."
can_fast_forward = false
image = ExtResource("18_42pdu")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText12" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Keadaan ketika sistem mencoba menambahkan data ke stack yang sudah penuh disebut [c]Overflow[/]."
can_fast_forward = false
image = ExtResource("18_42pdu")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText13" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Sekarang perhatikan keadaan berikutnya."
can_fast_forward = false
image = ExtResource("19_42pdu")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText14" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Rak kosong, kemudian sistem mencoba mengambil sebuah data."
can_fast_forward = false
image = ExtResource("19_42pdu")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText15" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Bagaimana menurutmu? Apakah sistem dapat mengambil buku dari rak tersebut"
can_fast_forward = false
image = ExtResource("19_42pdu")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText16" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Tentu tidak."
can_fast_forward = false
image = ExtResource("19_42pdu")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText17" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Karena tidak ada data yang dapat diambil."
can_fast_forward = false
image = ExtResource("19_42pdu")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText18" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Keadaan ketika sistem mencoba mengambil data dari stack yang kosong disebut [c]Underflow[/]."
can_fast_forward = false
image = ExtResource("19_42pdu")
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText19" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Jadi sebelum menyimpan atau mengambil data..."
can_fast_forward = false
npc_info = ExtResource("20_rxorh")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText20" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Sistem harus mengetahui terlebih dahulu apakah rak masih memiliki ruang atau justru sudah kosong?"
can_fast_forward = false
npc_info = ExtResource("20_rxorh")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText21" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Tepat sekali. Itulah sebabnya kondisi stack harus selalu diperiksa sebelum suatu operasi dilakukan."
can_fast_forward = false
npc_info = ExtResource("11_ve18a")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText22" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("10_pq7b4")
text = "Tepat sekali. Itulah sebabnya kondisi stack harus selalu diperiksa sebelum suatu operasi dilakukan."
can_fast_forward = false
