[node name="DialogInteraction" parent="Npc/QuestActivatedSwitch" instance=ExtResource("9_c70kq")]

[node name="DialogText" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Ruangan ini..."
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText2" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "...kenapa isinya banyak lemari seperti ini?"
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Tempat ini adalah [c]partisi penyimpanan data[/]."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText4" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Partisi penyimpanan?"
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText5" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Ya."
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText6" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Setiap lemari di ruangan ini menyimpan [c]tumpukan data[/] sistem."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText21" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Satu lemari mewakili satu penyimpanan data yang harus diperbaiki"
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText7" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Tumpukan data?"
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText8" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Sistem komputer ini menyimpan dan mengambil data menggunakan aturan tertentu."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText9" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Namun sejak sistem mengalami kerusakan..."
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText10" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "...banyak penyimpanan file yang bermasalah."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText12" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Jadi semua lemari ini bermasalah?"
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText13" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Benar."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText14" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Beberapa data tersusun tidak sesuai urutan."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText15" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Kalau begitu kita harus memperbaikinya satu per satu?"
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText16" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Tepat."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText17" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Setiap lemari memiliki permasalahan yang berbeda."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText18" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Dan kamu harus menyelesaikannya untuk membuka akses ke partisi berikutnya."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText19" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Jadi pintu itu baru terbuka kalau semua lemari selesai diperbaiki?"
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText20" type="Node" parent="Npc/QuestActivatedSwitch/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Ya. Perhatikan baik-baik bagaimana data masuk dan keluar dari [c]tumpukan[/]."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

