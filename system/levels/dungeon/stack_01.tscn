[node name="Pintu" parent="Items" instance=ExtResource("19_tiew0")]
position = Vector2(324, 32)
target_level = "uid://d0k2qddo55qqw"
correct_passcode = "fkx25"

[node name="Npc2" parent="." instance=ExtResource("8_vj2hy")]
z_index = 1
position = Vector2(487, 303)

[node name="DialogInteraction" parent="Npc2" instance=ExtResource("9_c70kq")]

[node name="DialogText" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Sepertinya sistem mulai kembali normal…"
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText2" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Benar."
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Kamu sudah memahami bagaimana data disusun dan diambil dalam stack."
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText4" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Tapi sistem ini masih belum stabil."
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText5" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Karena masih ada masalah pada mekanisme stack."
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText6" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Mekanisme?"
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText7" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Stack bukan hanya tentang urutan data."
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText8" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Setiap data memiliki aturan tertentu saat dimasukkan maupun dikeluarkan."
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText9" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Jadi sistem punya cara khusus untuk mengatur data?"
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText10" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Tepat."
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText11" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Untuk menyimpan data baru, sistem akan menaruhnya di bagian paling atas."
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText12" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Jadi data terus ditumpuk ke atas?"
npc_info = ExtResource("12_8x7r3")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText13" type="Node" parent="Npc2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Betul. Proses ini disebut push."
