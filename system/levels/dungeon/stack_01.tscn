metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Kamu sudah memahami bagaimana data disusun dan diambil dalam [c]stack[/]."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_edu8q")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText4" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction"]
script = ExtResource("10_1d11u")
text = "Tapi sistem ini masih belum stabil."
