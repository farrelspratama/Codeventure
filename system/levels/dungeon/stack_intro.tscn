[node name="DialogInteraction" parent="Npc/QuestActivatedSwitch2" instance=ExtResource("9_haitv")]

[node name="DialogText" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction"]
script = ExtResource("10_omn7h")
text = "Kamu sudah membaca buku itu?"
npc_info = ExtResource("11_ob2nk")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText2" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction"]
script = ExtResource("10_omn7h")
text = "Sudah."
npc_info = ExtResource("12_2qm6h")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction"]
script = ExtResource("10_omn7h")
text = "Jadi bagaimana cara kerja [c]stack[/]?"
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_ob2nk")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogChoice" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction"]
script = ExtResource("16_v35b1")
metadata/_custom_type_script = "uid://dicew2gcami5a"

[node name="DialogBranch" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction/DialogChoice"]
script = ExtResource("17_4qfoa")
text = "Stack bekerja seperti antrian"
metadata/_custom_type_script = "uid://cn7unf8c1h61s"

[node name="DialogText" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction/DialogChoice/DialogBranch"]
script = ExtResource("10_omn7h")
text = "Salah. Coba kamu pahami kembali."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_ob2nk")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogBranch2" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction/DialogChoice"]
script = ExtResource("17_4qfoa")
text = "Stack bekerja seperti tumpukan"
metadata/_custom_type_script = "uid://cn7unf8c1h61s"

[node name="QuestAdvanceTrigger" type="Node2D" parent="Npc/QuestActivatedSwitch2/DialogInteraction/DialogChoice/DialogBranch2"]
script = ExtResource("13_px22b")
signal_name = "selected"
linked_quest = ExtResource("14_5ow2c")
quest_step = 3
settings_summary = "UPDATE QUEST:
Quest: Storage Bermasalah
Step: 3 - memahami definisi stack
Complete: false"
metadata/_custom_type_script = "uid://cfspk0ixjj2av"

[node name="DialogText" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction/DialogChoice/DialogBranch2"]
script = ExtResource("10_omn7h")
text = "Benar. Tapi memahami definisi saja belum cukup."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_ob2nk")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction/DialogChoice/DialogBranch2"]
script = ExtResource("10_omn7h")
text = "Kamu harus melihat bagaimana [c]data bergerak[/] di dalam stack."
can_fast_forward = false
read_time_delay = 1.0
npc_info = ExtResource("11_ob2nk")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText4" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction/DialogChoice/DialogBranch2"]
script = ExtResource("10_omn7h")
text = "Maksudnya?"
npc_info = ExtResource("12_2qm6h")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText7" type="Node" parent="Npc/QuestActivatedSwitch2/DialogInteraction/DialogChoice/DialogBranch2"]
script = ExtResource("10_omn7h")
text = "Sistem stack itu bekerja menggunakan konsep [c]LIFO (Last In First Out)[/], artinya data yang [c]terakhir masuk[/] adalah yang [c]pertama kali keluar[/]."
can_fast_forward = false
