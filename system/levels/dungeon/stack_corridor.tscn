[node name="DialogText" type="Node" parent="AreaTrigger/DialogInteraction/IdentifikasiTop1/Pop/IdentifikasiTop2/Push/FungsiTop2/Menunjukkan"]
script = ExtResource("12_hfj8o")
text = "Benar, [c]TOP[/] digunakan untuk menunjukkan posisi data yang berada pada bagian paling atas dalam stack."
can_fast_forward = false
npc_info = ExtResource("13_u71a5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText2" type="Node" parent="AreaTrigger/DialogInteraction/IdentifikasiTop1/Pop/IdentifikasiTop2/Push/FungsiTop2/Menunjukkan"]
script = ExtResource("12_hfj8o")
text = "Dengan mengetahui posisi [c]TOP[/], kita dapat mengetahui data mana yang berada di urutan teratas."
can_fast_forward = false
npc_info = ExtResource("13_u71a5")
metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText3" type="Node" parent="AreaTrigger/DialogInteraction/IdentifikasiTop1/Pop/IdentifikasiTop2/Push/FungsiTop2/Menunjukkan"]
script = ExtResource("12_hfj8o")
text = "Jadi [c]TOP[/] berfungsi sebagai penanda posisi teratas pada stack?"
