[node name="DialogText5" type="Node" parent="AreaTrigger/DialogInteraction/IdentifikasiTop1/Pop/IdentifikasiTop2/Push/FungsiTop2/Menunjukkan"]
script = ExtResource("12_hfj8o")
text = "Kamu sudah berhasil mengidentifikasi salah satu bagian penting dari struktur stack."
