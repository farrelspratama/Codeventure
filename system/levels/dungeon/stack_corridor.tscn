metadata/_custom_type_script = "uid://b2gbmxj3vikwc"

[node name="DialogText6" type="Node" parent="AreaTrigger/DialogInteraction/IdentifikasiTop1/Pop/IdentifikasiTop2/Push/FungsiTop2/Menunjukkan"]
